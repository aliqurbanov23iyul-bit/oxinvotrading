# FRONTEND ONLY. Every VITE_* value is public browser configuration.
# Local development uses Vite's /api proxy to 127.0.0.1:4000.
VITE_API_BASE_URL=/api/v1
# Production default: https://api.oxinvo.com/api/v1
# Never put DATABASE_URL, tokens, API keys or encryption keys in this file.
# Backend environment files live only under backend/.
