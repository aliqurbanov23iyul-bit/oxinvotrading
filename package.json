{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "node scripts/run.cjs dev",
    "start:backend": "npm run start --prefix backend",
    "bootstrap:admin": "npm run bootstrap:admin --prefix backend",
    "start:production:backend": "npm run start:production --prefix backend",
    "build": "vite build",
    "build:frontend": "vite build",
    "generate:seo": "node scripts/generate-public-pages.mjs",
    "build:vercel": "npm run build:frontend && node scripts/generate-public-pages.mjs && node scripts/check-frontend-secrets.cjs",
    "check:frontend-secrets": "node scripts/check-frontend-secrets.cjs",
    "check:repository-secrets": "node scripts/check-repository-secrets.cjs",
    "build:backend": "npm run build --prefix backend",
    "preview": "vite preview",
    "clean": "node scripts/clean.cjs",
    "lint": "tsc --noEmit",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "test": "node scripts/run.cjs test",
    "test:frontend": "node --import tsx --test src/utils/security.test.ts src/utils/tradingMath.test.ts src/services/api-client.test.ts",
    "test:backend": "npm run test --prefix backend",
    "backend:env": "npm run env:init --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:validate": "npm run db:validate --prefix backend",
    "db:status": "npm run db:status --prefix backend",
    "db:test:prepare": "npm run db:test:prepare --prefix backend",
    "test:database": "npm run test:database --prefix backend",
    "test:auth": "npm run test:auth --prefix backend",
    "db:check": "npm run db:check --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:validate": "npm run prisma:validate --prefix backend",
    "auth:status": "npm run auth:status --prefix backend"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
