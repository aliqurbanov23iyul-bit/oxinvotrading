# Copy using npm run env:init --prefix backend (creates random local keys; no overwrite).
NODE_ENV=development
PORT=4000
# Neon DEVELOPMENT branch only. Copy exact values privately from Neon Connect.
DATABASE_ENV=development
NEON_BRANCH_HOST=ep-development-endpoint.eu-central-1.aws.neon.tech
DATABASE_URL=postgresql://APP_ROLE:CHANGE_ME@ep-development-endpoint-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require&schema=public
DATABASE_URL_UNPOOLED=postgresql://MIGRATION_ROLE:CHANGE_ME@ep-development-endpoint.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require&schema=public
FRONTEND_URL=http://127.0.0.1:3000
# Independent, random 32-byte base64 keys. Never commit real values.
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_BASE64
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64
LOG_LEVEL=info

# Enable only after loopback-only trusted tunnel forwarding is verified.
TRUST_PROXY=false
