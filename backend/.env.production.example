# Windows NestJS process ONLY. Never copy these keys to frontend VITE_* variables.
# Copy privately to backend/.env.production.local when production is authorized.
NODE_ENV=production
PORT=4000
DATABASE_ENV=production
NEON_BRANCH_HOST=ep-production-endpoint.eu-central-1.aws.neon.tech
DATABASE_URL=postgresql://APP_ROLE:CHANGE_ME@ep-production-endpoint-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require&schema=public
DATABASE_URL_UNPOOLED=postgresql://MIGRATION_ROLE:CHANGE_ME@ep-production-endpoint.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require&schema=public
FRONTEND_URL=https://oxinvo.com
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_BASE64
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64
LOG_LEVEL=info

# Enable only after loopback-only trusted tunnel forwarding is verified.
TRUST_PROXY=false
